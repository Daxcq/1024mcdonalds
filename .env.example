MCD_MCP_URL=https://mcp.mcd.cn
MCD_MCP_TOKEN=your_mcd_mcp_token

# StepFun 阶跃星辰 (OpenAI 兼容, 国内站 platform.stepfun.com)
LLM_API_KEY=your_stepfun_key
LLM_BASE_URL=https://api.stepfun.com/v1
# 官方文档标注支持工具调用: step-5-preview / step-3.7-flash / step-3.5-flash / step-3.5-flash-2603
LLM_MODEL=step-3.7-flash
# 可选: step-3.7-flash 支持三档推理强度 low/medium/high, 点单推荐 low 以降低延迟
# LLM_REASONING_EFFORT=low

# 若使用国际站 platform.stepfun.ai, base_url 改为 https://api.stepfun.ai/v1
# 若使用 Step Plan 订阅通道, base_url 为 https://api.stepfun.com/step_plan/v1

# 演示模式: 默认 1(只能算价)。设 0 才会真正创建订单, 用的是 MCD_MCP_TOKEN 绑定的真实账号。
# DEMO_MODE=1

# 公网访问口令: 设置后所有 /api 请求必须带 X-Access-Key(页面首次访问会弹框让你输入)。
# 留空 = 不校验, 只适合本机。部署到公网时务必设置。
# ACCESS_KEY=change-me-before-going-public
